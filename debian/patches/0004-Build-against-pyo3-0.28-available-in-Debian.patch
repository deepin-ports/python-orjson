From: Edward Betts <edward@4angle.com>
Date: Wed, 28 Oct 2026 10:21:31 +0000
Subject: Build against pyo3 0.28 available in Debian

pyo3 0.29 is not yet packaged in Debian; only 0.28.2 is in sid.
Downgrade pyo3-ffi/pyo3-build-config to 0.28 and revert the 0.29-only
build-config API in build.rs. Drop PyFrozenDict_New (pyo3 0.29-only)
and look up the frozendict type via builtins.frozendict instead.
---
 Cargo.toml     |  4 ++--
 build.rs       | 14 +++++---------
 src/ffi/mod.rs |  4 ----
 src/typeref.rs |  7 +++----
 4 files changed, 10 insertions(+), 19 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 1beba80..004aad8 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -44,14 +44,14 @@ bytecount = { version = "^0.6.7", default-features = false, features = ["runtime
 itoap = { version = "1", default-features = false, features = ["std", "simd"] }
 jiff-core = { version = "0.1", default-features = false }
 once_cell = { version = "1", default-features = false, features = ["alloc", "race"] }
-pyo3-ffi = { version = "0.29", default-features = false }
+pyo3-ffi = { version = "0.28", default-features = false }
 simdutf8 = { version = "0.1", default-features = false, features = ["std", "public_imp", "aarch64_neon"] }
 xxhash-rust = { version = "^0.8", default-features = false, features = ["xxh3"] }
 zmij = { version = "1", default-features = false }
 
 [build-dependencies]
 cc = { version = "1" }
-pyo3-build-config = { version = "0.29" }
+pyo3-build-config = { version = "0.28" }
 
 [profile.dev]
 codegen-units = 1
diff --git a/build.rs b/build.rs
index 6568def..cb1f4ca 100644
--- a/build.rs
+++ b/build.rs
@@ -9,26 +9,22 @@ fn main() {
     }
 
     #[allow(unused_variables)]
-    let is_64_bit_python = matches!(python_config.pointer_width(), Some(64));
+    let is_64_bit_python = matches!(python_config.pointer_width, Some(64));
 
-    match python_config.implementation() {
+    match python_config.implementation {
         pyo3_build_config::PythonImplementation::CPython => {
             println!("cargo:rustc-cfg=CPython");
-            let is_abi3 = matches!(
-                python_config.target_abi().kind(),
-                pyo3_build_config::PythonAbiKind::Stable(_)
-            );
-            if is_abi3 {
+            if python_config.abi3 {
                 println!("cargo:rustc-cfg=Py_LIMITED_ABI");
             }
             #[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
-            if is_64_bit_python && !is_abi3 {
+            if is_64_bit_python && !python_config.abi3 {
                 println!("cargo:rustc-cfg=feature=\"inline_int\"");
                 #[cfg(target_endian = "little")]
                 println!("cargo:rustc-cfg=feature=\"inline_str\"");
             }
         }
-        _ => not_supported(&python_config.implementation().to_string()),
+        _ => not_supported(&python_config.implementation.to_string()),
     }
 
     for cfg in python_config.build_script_outputs() {
diff --git a/src/ffi/mod.rs b/src/ffi/mod.rs
index 6cee0c7..a7edbf0 100644
--- a/src/ffi/mod.rs
+++ b/src/ffi/mod.rs
@@ -136,7 +136,3 @@ pub(crate) use pyo3_ffi::{PyDict_Contains, PyDictObject};
 #[cfg(Py_3_13)]
 #[allow(unused_imports)]
 pub(crate) use pyo3_ffi::{Py_MOD_GIL_NOT_USED, Py_MOD_GIL_USED, Py_mod_gil};
-
-#[cfg(Py_3_15)]
